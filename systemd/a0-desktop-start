#!/bin/sh
# Start the Agent Zero desktop session inside the application sandbox.
# Idempotent: the plugin returns the existing session when one is running.
# Waits for the Web UI first, so it also works when both units start at boot.
A0_PORT=${A0_PORT:-5080}
for _ in $(seq 1 60); do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:$A0_PORT/api/health" 2>/dev/null)
    [ "$code" = 200 ] && break
    sleep 2
done
if [ "$code" != 200 ]; then
    echo "agent-zero: UI health is ${code:-000} after 120s; starting the desktop anyway" >&2
fi

# Wait for the X server named by DISPLAY. A graphical boot can start this unit
# before display-manager has created the socket; a headless boot falls through
# to the sandbox Xvfb after the wait.
if [ -n "${DISPLAY:-}" ]; then
    _num=${DISPLAY#*:}
    _num=${_num%%.*}
    if [ -n "$_num" ]; then
        for _ in $(seq 1 30); do
            [ -S "/tmp/.X11-unix/X$_num" ] && break
            sleep 1
        done
    fi
fi

# GDM and Wayland sessions keep the cookie outside ~/.Xauthority. Flatpak
# mounts whatever XAUTHORITY points at, so prefer the session cookie when the
# unit's default is missing.
if [ ! -r "${XAUTHORITY:-$HOME/.Xauthority}" ]; then
    for _file in "/run/user/$(id -u)/gdm/Xauthority" /run/user/"$(id -u)"/.mutter-Xwaylandauth.*; do
        if [ -r "$_file" ]; then
            XAUTHORITY=$_file
            export XAUTHORITY
            break
        fi
    done
fi

exec flatpak run --user --command=sh org.agentzero.AgentZero -s <<'INNER'
export LD_LIBRARY_PATH=/app/lib/gi:/app/lib/xvfb
B="${XDG_DATA_HOME:-$HOME/.local/share}/agent-zero"
export A0_BASE_DIR="$B"
cd /app/share/agent-zero
GIT_PYTHON_REFRESH=quiet PYTHONPATH=/app/share/agent-zero:/app/share/agent-zero/flatpak:/app/share/python-deps \
  "$B/venv/bin/python" -c 'import a0flatpak; a0flatpak.apply()
from plugins._desktop.helpers import desktop_session as ds
r = ds.DesktopSessionManager().ensure_system_desktop()
print("desktop:", r.get("available"), r.get("error") or "")
raise SystemExit(0 if r.get("available") else 1)'
INNER
