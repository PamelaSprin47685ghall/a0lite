[Unit]
Description=Agent Zero, Flatpak build, all inference through the bundled Ollama
Documentation=https://github.com/PamelaSprin47685ghall/a0lite
# User-specific settings (User=, Group=, home, runtime dir) are written by
# scripts/install-services.sh into agent-zero.service.d/10-user.conf. Refuse
# to start as root when that drop-in is missing.
AssertPathExists=/etc/systemd/system/agent-zero.service.d/10-user.conf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DISPLAY=:0
ExecStart=/usr/bin/flatpak run --user org.agentzero.AgentZero
Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=control-group

[Install]
WantedBy=multi-user.target
